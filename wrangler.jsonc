{
  // Cloudflare Workers static-assets config for compare.flowstore.org.
  // The connected-repo build runs `npm run build:compare` (compare-rooted
  // dist: index.html = compare, create.html = editor on the same origin),
  // then `npx wrangler deploy` uploads the directory below. _headers (CSP)
  // and examples/ inside it are honored as-is.
  "name": "flowstore-compare",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "packages/browser/dist"
  }
}
