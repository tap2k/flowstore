{
  "name": "@flowstore/core",
  "version": "0.1.0-alpha.1",
  "description": "Flowstore core — schema, codegen, validation, and runtime",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.mjs", "require": "./dist/index.js" },
    "./ids": { "types": "./dist/ids.d.ts", "import": "./dist/ids.mjs", "require": "./dist/ids.js" },
    "./schema": { "types": "./dist/schema/index.d.ts", "import": "./dist/schema/index.mjs", "require": "./dist/schema/index.js" },
    "./schema/*": { "types": "./dist/schema/*.d.ts", "import": "./dist/schema/*.mjs", "require": "./dist/schema/*.js" },
    "./codegen": { "types": "./dist/codegen/index.d.ts", "import": "./dist/codegen/index.mjs", "require": "./dist/codegen/index.js" },
    "./codegen/*": { "types": "./dist/codegen/*.d.ts", "import": "./dist/codegen/*.mjs", "require": "./dist/codegen/*.js" },
    "./validation": { "types": "./dist/validation/index.d.ts", "import": "./dist/validation/index.mjs", "require": "./dist/validation/index.js" },
    "./validation/*": { "types": "./dist/validation/*.d.ts", "import": "./dist/validation/*.mjs", "require": "./dist/validation/*.js" },
    "./files": { "types": "./dist/files/index.d.ts", "import": "./dist/files/index.mjs", "require": "./dist/files/index.js" },
    "./files/*": { "types": "./dist/files/*.d.ts", "import": "./dist/files/*.mjs", "require": "./dist/files/*.js" },
    "./llm": { "types": "./dist/llm/index.d.ts", "import": "./dist/llm/index.mjs", "require": "./dist/llm/index.js" },
    "./llm/*": { "types": "./dist/llm/*.d.ts", "import": "./dist/llm/*.mjs", "require": "./dist/llm/*.js" },
    "./llm/providers/*": { "types": "./dist/llm/providers/*.d.ts", "import": "./dist/llm/providers/*.mjs", "require": "./dist/llm/providers/*.js" },
    "./runtime": { "types": "./dist/runtime/index.d.ts", "import": "./dist/runtime/index.mjs", "require": "./dist/runtime/index.js" },
    "./runtime/*": { "types": "./dist/runtime/*.d.ts", "import": "./dist/runtime/*.mjs", "require": "./dist/runtime/*.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "preview-prompt": "tsx scripts/preview-prompt.ts",
    "round-trip": "tsx scripts/round-trip.ts",
    "round-trip-disk": "tsx scripts/round-trip-disk.ts",
    "github-smoke": "tsx scripts/github-smoke.ts",
    "github-init": "tsx scripts/github-init.ts",
    "flowstore-init-project": "tsx scripts/flowstore-init-project.ts",
    "flowstore-compile": "tsx scripts/flowstore-compile.ts"
  },
  "dependencies": {
    "@octokit/rest": "^21.1.1",
    "@sinclair/typebox": "^0.34.49",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsup": "^8.5.1",
    "tsx": "^4"
  }
}
