# Cloudflare Pages response headers. Vite copies public/ into dist/, and Pages
# serves dist/_headers at deploy. `vite dev` is unaffected; `vite preview`
# mirrors the CSP (vite.config.ts parses this file into preview.headers), so
# validate locally with build+preview before trusting a Pages deploy.
#
# CSP rationale (XSS hardens the plaintext credentials in localStorage):
#   script-src   no 'unsafe-inline' — this is the directive that actually
#                defends the LLM keys + GitHub token. googletagmanager is the one
#                external script (GA4 gtag.js); it's a named origin, not a hole.
#                'unsafe-eval' is for Ajv, which compiles the spec schema via
#                new Function at load (blocking it bricks spec validation).
#                Eval-of-strings only — an attacker still can't inject inline or
#                external script. Drop it if validation ever moves to TypeBox's
#                Value.Check (interprets, no codegen; schema is TypeBox already).
#   style-src    'unsafe-inline' — React/Tailwind inject inline styles; inline
#                styles don't carry the script-exfil risk, standard relaxation.
#   connect-src  permissive (https: wss:) by design — the app is BYO-endpoint
#                (custom runner URL, openai-compatible base_url, live capability
#                endpoints are all arbitrary user input; Gemini Live needs wss).
#                Safe because script-src stays tight: no injected code to abuse it.
#                http://localhost:* / 127.0.0.1:* so a deployed session can reach
#                a local runner or capability endpoint (default runner URL is
#                http://localhost:8000).
#   img-src      *.google-analytics.com for GA beacon pixels; data: for inline svg.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.google-analytics.com; font-src 'self'; connect-src 'self' https: wss: http://localhost:* http://127.0.0.1:*; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
