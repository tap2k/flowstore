---
import Base from "../layouts/Base.astro";

const compareUrl = "/compare/";
const editorUrl = "/create/";
const repoUrl = "https://github.com/tap2k/flowstore";
---

<Base
  title="flowstore — a Behavioral IDE for Conversational Agents"
  description="Compare the cost and behavior of different models, author conversation specs on a canvas, decompose them into per-concern files in a Git repo, and compile a system prompt as a pure function of the spec."
>
  <main class="mx-auto flex min-h-screen max-w-3xl flex-col justify-center px-6 py-20">
    <p class="font-mono text-sm font-semibold tracking-tight text-slate-500">flowstore</p>
    <h1 class="mt-6 text-4xl font-semibold tracking-tight text-slate-900 sm:text-5xl">
      A Behavioral IDE for Conversational Agents.
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-slate-600">
      Author conversation specs on a canvas, decompose them into per-concern files in a Git repo, and compile a system prompt as a pure function of the spec.
    </p>
    <div class="mt-10 grid items-stretch gap-4 sm:grid-cols-2">
      <a
        href={compareUrl}
        class="flex flex-col rounded-xl border border-slate-300 bg-slate-50 p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-slate-400 hover:shadow-md"
      >
        <p class="text-base font-semibold text-slate-900">Compare →</p>
        <p class="mt-2 text-sm leading-relaxed text-slate-600">
          Paste a system prompt, run it across models side by side — behavior,
          latency, and cost, including speech-to-speech. 
        </p>
      </a>
      <a
        href={editorUrl}
        class="flex flex-col rounded-xl border border-slate-300 bg-slate-50 p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-slate-400 hover:shadow-md"
      >
        <p class="text-base font-semibold text-slate-900">Create →</p>
        <p class="mt-2 text-sm leading-relaxed text-slate-600">
          Author the behavioral spec on a canvas, simulate conversations interactively,
          and compile the system prompt from the spec.
        </p>
      </a>
    </div>
    <div class="mt-6">
      <a
        href={repoUrl}
        class="rounded-md border border-slate-300 px-5 py-2.5 text-sm font-medium text-slate-900 hover:bg-slate-50"
      >
        View on GitHub
      </a>
    </div>
  </main>
</Base>
