---
import Base from "../layouts/Base.astro";

const startUrl = "/start/";
const editorUrl = "/create/";
const repoUrl = "https://github.com/tap2k/flowstore";
---

<Base
  title="flowstore — design conversational agents"
  description="Design conversational agents on a canvas, test them as you build, and compile to a system prompt you can use anywhere."
>
  <main class="mx-auto flex min-h-screen max-w-3xl flex-col justify-center px-6 py-20">
    <p class="font-mono text-sm font-semibold tracking-tight text-slate-500">flowstore</p>
    <h1 class="mt-6 text-4xl font-semibold tracking-tight text-balance text-slate-900 sm:text-5xl">
      Design conversational agents on a canvas.
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-slate-600">
      Graph the conversation, test your agent as you build it, and compile to a
      system prompt you can use anywhere. It runs in your browser with your own API keys.
    </p>
    <div class="mt-10 flex flex-wrap items-center gap-3">
      <a
        href={startUrl}
        class="rounded-md bg-slate-900 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-black"
      >
        Get started →
      </a>
      <a
        href={editorUrl}
        class="rounded-md border border-slate-300 px-5 py-3 text-sm font-medium text-slate-900 transition hover:border-slate-400 hover:bg-slate-50"
      >
        Open the editor
      </a>
    </div>
    <p class="mt-4 text-sm text-slate-500">
      <a href={startUrl} class="underline decoration-slate-300 underline-offset-4 hover:text-slate-900 hover:decoration-slate-900">New here? Start with the three-minute tour and a 15-minute walkthrough.</a>
    </p>
    <p class="mt-10 text-sm text-slate-500">
      <a href={repoUrl} class="underline decoration-slate-300 underline-offset-4 hover:text-slate-900 hover:decoration-slate-900">View on GitHub</a>
    </p>
  </main>
</Base>
